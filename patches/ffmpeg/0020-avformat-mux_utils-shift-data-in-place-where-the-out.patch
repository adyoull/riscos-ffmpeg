From 821a860d45818ad5ebd1e4637815393fac079b7e Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Tue, 29 Sep 2026 12:01:29 +0100
Subject: [PATCH] avformat/mux_utils: shift data in place where the output
 can't be opened twice (RISC OS)

-movflags +faststart moves the moov atom to the front by opening the
output a second time for reading, which RISC OS refuses while it is
open for writing ("This file is already open", 0x108C2). There the
output is closed, the data shifted in place through one read-write
opening (from the end backwards), and the output opened again for
writing without truncating. Elsewhere this is used only when the second
opening fails, or when FFMPEG_SHIFT_IN_PLACE is set (for testing).
---
 libavformat/mux_utils.c | 65 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 64 insertions(+), 1 deletion(-)

diff --git a/libavformat/mux_utils.c b/libavformat/mux_utils.c
index eb8ea3d..80c1561 100644
--- a/libavformat/mux_utils.c
+++ b/libavformat/mux_utils.c
@@ -28,6 +28,60 @@
 #include "avio.h"
 #include "internal.h"
 #include "mux.h"
+#include "url.h"
+#include <stdlib.h>
+
+/* RISC OS won't open a file a second time while it's open for writing
+ * ("This file is already open"), so the read-only second opening below
+ * fails there. Instead: close the output, shift the data along in place
+ * through one read-write opening, from the end backwards (so nothing is
+ * overwritten before it's read), and open the output again for writing
+ * without truncating it, at the end of the shifted data. Also used
+ * elsewhere when the second opening fails, and (for testing) when
+ * FFMPEG_SHIFT_IN_PLACE is set. */
+static int shift_in_place(AVFormatContext *s, int64_t read_start, int shift_size, int64_t pos_end)
+{
+    URLContext *h = NULL;
+    AVDictionary *opts = NULL;
+    int size = 1 << 18, ret, ret2;              /* (file: writes of at most 256 KB) */
+    int64_t p = pos_end;
+    uint8_t *buf = av_malloc(size);
+
+    if (!buf)
+        return AVERROR(ENOMEM);
+    avio_flush(s->pb);
+    ff_format_io_close(s, &s->pb);
+    av_dict_set(&opts, "truncate", "0", 0);             /* (file: the default truncates) */
+    ret = ffurl_open_whitelist(&h, s->url, AVIO_FLAG_READ_WRITE, &s->interrupt_callback, &opts,
+                               s->protocol_whitelist, s->protocol_blacklist, NULL);
+    av_dict_free(&opts);
+    while (ret >= 0 && p > read_start) {
+        int n = (int)FFMIN(size, p - read_start);
+        p -= n;
+        if ((ret = ffurl_seek(h, p, SEEK_SET) < 0 ? AVERROR(EIO) : 0) < 0 ||
+            (ret = ffurl_read_complete(h, buf, n)) < 0)
+            break;
+        if (ret != n) {
+            ret = AVERROR(EIO);
+            break;
+        }
+        if ((ret = ffurl_seek(h, p + shift_size, SEEK_SET) < 0 ? AVERROR(EIO) : 0) < 0 ||
+            (ret = ffurl_write(h, buf, n)) < 0)
+            break;
+    }
+    ffurl_closep(&h);
+    av_free(buf);
+    if (ret < 0)
+        av_log(s, AV_LOG_ERROR, "Unable to shift the data in %s in place\n", s->url);
+    /* the output again, for the rest of the trailer */
+    av_dict_set(&opts, "truncate", "0", 0);
+    ret2 = s->io_open(s, &s->pb, s->url, AVIO_FLAG_READ_WRITE, &opts);
+    av_dict_free(&opts);
+    if (ret2 < 0)
+        return ret2;
+    avio_seek(s->pb, pos_end + shift_size, SEEK_SET);
+    return ret < 0 ? ret : 0;
+}
 
 int64_t av_stream_get_end_pts(const AVStream *st)
 {
@@ -74,8 +128,17 @@ int ff_format_shift_data(AVFormatContext *s, int64_t read_start, int shift_size)
      * writing, so we re-open the same output, but for reading. It also avoids
      * a read/seek/write/seek back and forth. */
     avio_flush(s->pb);
-    ret = s->io_open(s, &read_pb, s->url, AVIO_FLAG_READ, NULL);
+#ifdef __riscos__
+    ret = AVERROR(EBUSY);                       /* (it can't be opened twice) */
+#else
+    ret = getenv("FFMPEG_SHIFT_IN_PLACE") ? AVERROR(EBUSY) :
+          s->io_open(s, &read_pb, s->url, AVIO_FLAG_READ, NULL);
+#endif
     if (ret < 0) {
+        if (!(s->flags & AVFMT_FLAG_CUSTOM_IO)) {
+            ret = shift_in_place(s, read_start, shift_size, avio_tell(s->pb));
+            goto end;
+        }
         av_log(s, AV_LOG_ERROR, "Unable to re-open %s output file for shifting data\n", s->url);
         goto end;
     }
-- 
2.43.0

