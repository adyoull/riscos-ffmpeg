From f495f604008dedde1e26d0e85e423bda60955c9d Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Sun, 27 Sep 2026 08:16:51 +0100
Subject: [PATCH 02/11] RISC OS: heap dynamic area "FFmpeg Heap", 128 MB

---
 fftools/cmdutils.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/fftools/cmdutils.c b/fftools/cmdutils.c
index 1c75cfa..f05d955 100644
--- a/fftools/cmdutils.c
+++ b/fftools/cmdutils.c
@@ -55,6 +55,16 @@
 #include "compat/w32dlfcn.h"
 #endif
 
+#ifdef __riscos__
+/* UnixLib puts the heap in a dynamic area with a 32 MB limit unless told
+ * otherwise; a few HD frames plus x264's lookahead need far more. The
+ * size is logical address space reserved whole when the area is made,
+ * however little is in it (DALimit lets 1GB through on some machines):
+ * 128 MB, and UnixLib adds "FFmpeg Heap 2" and on when it needs more. */
+const char *const __dynamic_da_name = "FFmpeg Heap";
+int __dynamic_da_max_size = 128 << 20;
+#endif
+
 AVDictionary *sws_dict;
 AVDictionary *swr_opts;
 AVDictionary *format_opts, *codec_opts;
