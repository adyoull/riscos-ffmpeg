From 3a6b9e61928c0ed68da437f5f0c1e98528f8184b Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Sun, 27 Sep 2026 12:55:00 +0100
Subject: [PATCH] ffplay (RISC OS): in a TaskWindow, run as a desktop task of
 its own

SDL can't open a window from a TaskWindow (Wimp_Initialise: "Window
Manager is currently in use"). ffplay starts itself again with
Wimp_StartTask, through the Obey file Task next to it (WimpSlot), with
its messages in <Wimp$ScrapDir>.ffplay/log. FFPLAY_NEWTASK=0 turns it off.

Our VFP context is switched off around Wimp_StartTask (one asm block),
as UnixLib does before running another program: otherwise VFPSupport
later saves it lazily to our stack address, which by then belongs to the
new task (seen on the Pi: "abort on data transfer" in VFPSupport, and an
EMT trap in the new ffplay's video decoder thread).

---
 fftools/ffplay.c | 96 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 96 insertions(+)

diff --git a/fftools/ffplay.c b/fftools/ffplay.c
index 934212f..8108b72 100644
--- a/fftools/ffplay.c
+++ b/fftools/ffplay.c
@@ -874,6 +874,98 @@ static void calculate_display_rect(SDL_Rect *rect,
     rect->h = FFMAX((int)height, 1);
 }
 
+#ifdef __riscos__
+#include <kernel.h>
+
+/* Wimp_StartTask with our VFP context switched off meanwhile. UnixLib
+ * keeps that context on our stack; the new task's UnixLib creates its own
+ * context, and VFPSupport would first save ours to an address that is no
+ * longer mapped: "abort on data transfer" in VFPSupport (UnixLib does the
+ * same before running another program). The three SWIs are one asm block
+ * so the compiler can't put a VFP/NEON instruction between them. */
+static _kernel_oserror *riscos_start_task(const char *cmd)
+{
+#if defined(__arm__)
+    _kernel_oserror *err;
+    __asm__ volatile(
+        "mov    r0, #0\n\t"
+        "mov    r1, #0\n\t"
+        "swi    0x78EC3\n\t"          /* XVFPSupport_ChangeContext 0: off */
+        "movvs  r0, #0\n\t"
+        "mov    r4, r0\n\t"           /* the old context */
+        "mov    r0, %1\n\t"
+        "swi    0x600DE\n\t"          /* XWimp_StartTask */
+        "movvs  %0, r0\n\t"
+        "movvc  %0, #0\n\t"
+        "movs   r0, r4\n\t"
+        "mov    r1, #0\n\t"
+        "swine  0x78EC3\n\t"          /* back on */
+        : "=&r"(err) : "r"(cmd) : "r0", "r1", "r2", "r3", "r4", "r14", "cc", "memory");
+    return err;
+#else   /* host tests (tests/host/ffplay-direct.sh) */
+    _kernel_swi_regs r;
+    r.r[0] = (intptr_t)cmd;
+    return _kernel_swi(0x400DE, &r, &r);
+#endif
+}
+
+/* RISC OS: a program running in a TaskWindow can't open windows: the
+ * TaskWindow is already its Wimp task, so SDL's Wimp_Initialise fails with
+ * "Window Manager is currently in use". ffplay then starts itself again as
+ * a desktop task of its own (Wimp_StartTask, as *WimpTask does), through
+ * the Obey file "Task" next to it, which sets the WimpSlot and runs the
+ * program named in its first argument from the same directory. Its messages go
+ * to <Wimp$ScrapDir>.ffplay/log, and the TaskWindow is free at once.
+ * FFPLAY_NEWTASK=0 turns this off. Returns only if it didn't happen. */
+static void riscos_leave_taskwindow(int argc, char **argv)
+{
+    _kernel_swi_regs r;
+    const char *no = getenv("FFPLAY_NEWTASK"), *scrap = getenv("Wimp$ScrapDir");
+    char self[256], cmd[1024], log[256];
+    const char *env, *leaf;
+    size_t n;
+    AVBPrint bp;
+    _kernel_oserror *err;
+
+    if (no && *no == '0')
+        return;
+    r.r[0] = 0;                                   /* TaskWindow_TaskInfo 0 */
+    if (_kernel_swi(0x43380, &r, &r) || r.r[0] == 0)
+        return;                                   /* not in a TaskWindow */
+    /* this program's own RISC OS path: the first word of its command line */
+    if (_kernel_swi(0x10 /* OS_GetEnv */, &r, &r))
+        return;
+    env = (const char *)(intptr_t)r.r[0];
+    for (n = 0; env[n] > ' ' && n < sizeof(self) - 1; n++)
+        self[n] = env[n];
+    self[n] = 0;
+    leaf = strrchr(self, '.');
+    if (!leaf || !scrap || !*scrap) {
+        av_log(NULL, AV_LOG_WARNING, "ffplay: can't start a desktop task from here "
+               "(run it with *WimpTask)\n");
+        return;
+    }
+    snprintf(log, sizeof(log), "%s.ffplay/log", scrap);
+    av_bprint_init_for_buffer(&bp, cmd, sizeof(cmd));
+    av_bprintf(&bp, "Obey %.*sTask %s -nostats -hide_banner", (int)(leaf + 1 - self), self, leaf + 1);
+    for (int i = 1; i < argc; i++)
+        av_bprintf(&bp, strchr(argv[i], ' ') ? " \"%s\"" : " %s", argv[i]);
+    av_bprintf(&bp, " > %s 2>&1", log);
+    if (!av_bprint_is_complete(&bp)) {
+        av_log(NULL, AV_LOG_WARNING, "ffplay: command line too long for a new task\n");
+        return;
+    }
+    fprintf(stderr, "ffplay: a TaskWindow can't open windows, so ffplay runs as its own\n"
+                    "desktop task. Its messages go to %s\n", log);
+    err = riscos_start_task(cmd);
+    if (err) {
+        av_log(NULL, AV_LOG_WARNING, "ffplay: Wimp_StartTask failed: %s\n", err->errmess);
+        return;
+    }
+    exit(0);
+}
+#endif
+
 #ifdef __riscos__
 /* RISC OS: draw video straight into the window.
  *
@@ -3862,6 +3954,10 @@ int main(int argc, char **argv)
     if (display_disable) {
         video_disable = 1;
     }
+#ifdef __riscos__
+    if (!display_disable)
+        riscos_leave_taskwindow(argc, argv);
+#endif
     flags = SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_TIMER;
     if (audio_disable)
         flags &= ~SDL_INIT_AUDIO;
-- 
2.43.0

