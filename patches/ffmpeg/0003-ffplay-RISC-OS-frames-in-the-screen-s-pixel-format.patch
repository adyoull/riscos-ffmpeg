From af4b971e8b46311753ca99bac5e4e5f3ae4df3e4 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Sun, 27 Sep 2026 08:16:51 +0100
Subject: [PATCH 3/3] ffplay, RISC OS: frames in the screen's pixel format

---
 fftools/ffplay.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/fftools/ffplay.c b/fftools/ffplay.c
index 99c93e5..245c731 100644
--- a/fftools/ffplay.c
+++ b/fftools/ffplay.c
@@ -873,11 +873,42 @@ static void calculate_display_rect(SDL_Rect *rect,
     rect->h = FFMAX((int)height, 1);
 }
 
+#ifdef __riscos__
+/* RISC OS: SDL draws into a sprite in the screen's own pixel format, through
+ * the software renderer. Hand it frames already in that format, so
+ * presenting one is a plain copy: swscale converts YUV to RGBA/BGRA with its
+ * NEON code, and those bytes are exactly the screen's XBGR/XRGB (the alpha
+ * byte is ignored). Otherwise SDL would convert YUV to RGB in plain C and
+ * then again to the screen format. */
+static enum AVPixelFormat riscos_av_fmt = AV_PIX_FMT_NONE;
+static Uint32 riscos_sdl_fmt = SDL_PIXELFORMAT_UNKNOWN;
+
+static void riscos_choose_format(SDL_Window *win)
+{
+    Uint32 f = SDL_GetWindowPixelFormat(win);
+    if (f == SDL_PIXELFORMAT_XBGR8888)
+        riscos_av_fmt = AV_PIX_FMT_RGBA;
+    else if (f == SDL_PIXELFORMAT_XRGB8888)
+        riscos_av_fmt = AV_PIX_FMT_BGRA;
+    else
+        return;   /* 16/256 colour modes: SDL's usual conversions */
+    riscos_sdl_fmt = f;
+    av_log(NULL, AV_LOG_VERBOSE, "Video frames as %s, the screen's format.\n",
+           av_get_pix_fmt_name(riscos_av_fmt));
+}
+#endif
+
 static void get_sdl_pix_fmt_and_blendmode(int format, Uint32 *sdl_pix_fmt, SDL_BlendMode *sdl_blendmode)
 {
     int i;
     *sdl_blendmode = SDL_BLENDMODE_NONE;
     *sdl_pix_fmt = SDL_PIXELFORMAT_UNKNOWN;
+#ifdef __riscos__
+    if (format == riscos_av_fmt) {
+        *sdl_pix_fmt = riscos_sdl_fmt;
+        return;
+    }
+#endif
     if (format == AV_PIX_FMT_RGB32   ||
         format == AV_PIX_FMT_RGB32_1 ||
         format == AV_PIX_FMT_BGR32   ||
@@ -1859,6 +1890,12 @@ static int configure_video_filters(AVFilterGraph *graph, VideoState *is, const c
         }
     }
     pix_fmts[nb_pix_fmts] = AV_PIX_FMT_NONE;
+#ifdef __riscos__
+    if (riscos_av_fmt != AV_PIX_FMT_NONE) {
+        pix_fmts[0] = riscos_av_fmt;
+        pix_fmts[1] = AV_PIX_FMT_NONE;
+    }
+#endif
 
     while ((e = av_dict_get(sws_dict, "", e, AV_DICT_IGNORE_SUFFIX))) {
         if (!strcmp(e->key, "sws_flags")) {
@@ -3739,6 +3776,9 @@ int main(int argc, char **argv)
             if (renderer) {
                 if (!SDL_GetRendererInfo(renderer, &renderer_info))
                     av_log(NULL, AV_LOG_VERBOSE, "Initialized %s renderer.\n", renderer_info.name);
+#ifdef __riscos__
+                riscos_choose_format(window);
+#endif
             }
         }
         if (!window || !renderer || !renderer_info.num_texture_formats) {
