diff --git a/libavcodec/arm/hevcdsp_epel_neon.S b/libavcodec/arm/hevcdsp_epel_neon.S
new file mode 100644
index 0000000..08275bc
--- /dev/null
+++ b/libavcodec/arm/hevcdsp_epel_neon.S
@@ -0,0 +1,247 @@
+/*
+ * HEVC chroma (epel) motion compensation in NEON for 32-bit ARM, 8 bits
+ *
+ * Bit-exact with hevcdsp_template.c's put_hevc_epel_{h,v,hv},
+ * _uni_{h,v,hv} and _bi_{h,v,hv}. The 4-tap filters are all
+ * (-, +, +, -), so the first pass is u8 x u8 multiply-accumulates with the
+ * outer taps subtracted (its sum always fits in 16 bits); the second pass
+ * of hv is 16 x 16 -> 32 bits. Columns in strips of 8, a strip's rows in
+ * turn (the vertical filter keeps its four rows in registers); the last
+ * strip of a width of 2, 4 or 6 stores only those. Byte loads (.8 on whole
+ * registers) and lane stores, so nothing needs aligning (RISC OS traps
+ * unaligned wider-element accesses).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/arm/asm.S"
+
+@ All of them:
+@ void f(void *dst, ptrdiff_t dststride, const void *src, ptrdiff_t srcstride,
+@        int height, const int8_t *filter, int width, const int16_t *src2)
+@ kind 0: int16_t dst (the unrounded filter), 1: uint8_t dst (uni),
+@ 2: uint8_t dst with src2 added (bi; src2's rows are 128 bytes apart).
+@
+@ r0 dst, r1 dststride, r2 src, r3 srcstride, r4 height, r5 scratch,
+@ r6 width, r7 src2, r8 x, r9 rows left, r10 dst row, r11 src row,
+@ ip src2 row, lr columns in this strip (2, 4, 6 or 8)
+
+.macro  epel_start
+        push            {r4-r11, lr}
+        ldr             r4,  [sp, #36]
+        ldr             r5,  [sp, #40]
+        ldr             r6,  [sp, #44]
+        ldr             r7,  [sp, #48]
+.endm
+
+@ the u8 taps: d28 |f0|, d29 f1, d30 f2, d31 |f3|
+.macro  epel_coeffs_u8
+        ldrsb           r8,  [r5]
+        ldrsb           r9,  [r5, #1]
+        ldrsb           r10, [r5, #2]
+        ldrsb           r11, [r5, #3]
+        rsb             r8,  r8,  #0
+        rsb             r11, r11, #0
+        vdup.8          d28, r8
+        vdup.8          d29, r9
+        vdup.8          d30, r10
+        vdup.8          d31, r11
+.endm
+
+@ the s16 taps in d7[0..3]
+.macro  epel_coeffs_s16
+        ldrsb           r8,  [r5]
+        ldrsb           r9,  [r5, #1]
+        ldrsb           r10, [r5, #2]
+        ldrsb           r11, [r5, #3]
+        vmov.16         d7[0], r8
+        vmov.16         d7[1], r9
+        vmov.16         d7[2], r10
+        vmov.16         d7[3], r11
+.endm
+
+@ the strip at x: its pointers and width
+.macro  epel_strip srcoff, elsize
+        sub             lr,  r6,  r8
+        cmp             lr,  #8
+        movgt           lr,  #8
+.if \elsize == 2
+        add             r10, r0,  r8,  lsl #1
+.else
+        add             r10, r0,  r8
+.endif
+        add             ip,  r7,  r8,  lsl #1
+        mov             r9,  r4
+.endm
+
+@ q8: 8 int16 results (before rounding) -> the destination row
+.macro  epel_out kind
+.if \kind == 0
+        cmp             lr,  #8
+        bne             1f
+        vst1.8          {d16-d17}, [r10], r1
+        b               2f
+1:      mov             r5,  r10
+        vst1.16         {d16[0]}, [r5]!
+        vst1.16         {d16[1]}, [r5]!
+        cmp             lr,  #4
+        blt             3f
+        vst1.16         {d16[2]}, [r5]!
+        vst1.16         {d16[3]}, [r5]!
+        cmp             lr,  #6
+        blt             3f
+        vst1.16         {d17[0]}, [r5]!
+        vst1.16         {d17[1]}, [r5]!
+3:      add             r10, r10, r1
+2:
+.else
+.if \kind == 2
+        vld1.8          {d18-d19}, [ip]
+        add             ip,  ip,  #128
+        vqadd.s16       q8,  q8,  q9
+        vqrshrun.s16    d16, q8,  #7
+.else
+        vqrshrun.s16    d16, q8,  #6
+.endif
+        cmp             lr,  #8
+        bne             1f
+        vst1.8          {d16}, [r10], r1
+        b               2f
+1:      mov             r5,  r10
+        vst1.8          {d16[0]}, [r5]!
+        vst1.8          {d16[1]}, [r5]!
+        cmp             lr,  #4
+        blt             3f
+        vst1.8          {d16[2]}, [r5]!
+        vst1.8          {d16[3]}, [r5]!
+        cmp             lr,  #6
+        blt             3f
+        vst1.8          {d16[4]}, [r5]!
+        vst1.8          {d16[5]}, [r5]!
+3:      add             r10, r10, r1
+2:
+.endif
+.endm
+
+@ horizontal, u8 source
+.macro  epel_h kind, elsize
+function ff_hevc_epel_h\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_u8
+        mov             r8,  #0
+4:
+        epel_strip      -1, \elsize
+        add             r11, r2,  r8
+        sub             r11, r11, #1
+5:
+        vld1.8          {d0-d1}, [r11], r3
+        vext.8          d2,  d0,  d1,  #1
+        vext.8          d3,  d0,  d1,  #2
+        vext.8          d4,  d0,  d1,  #3
+        vmull.u8        q8,  d2,  d29
+        vmlal.u8        q8,  d3,  d30
+        vmlsl.u8        q8,  d0,  d28
+        vmlsl.u8        q8,  d4,  d31
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        add             r8,  r8,  #8
+        cmp             r8,  r6
+        blt             4b
+        pop             {r4-r11, pc}
+endfunc
+.endm
+
+@ vertical, u8 source
+.macro  epel_v kind, elsize
+function ff_hevc_epel_v\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_u8
+        mov             r8,  #0
+4:
+        epel_strip      0, \elsize
+        add             r11, r2,  r8
+        sub             r11, r11, r3
+        vld1.8          {d0}, [r11], r3
+        vld1.8          {d1}, [r11], r3
+        vld1.8          {d2}, [r11], r3
+5:
+        vld1.8          {d3}, [r11], r3
+        vmull.u8        q8,  d1,  d29
+        vmlal.u8        q8,  d2,  d30
+        vmlsl.u8        q8,  d0,  d28
+        vmlsl.u8        q8,  d3,  d31
+        vmov            d0,  d1
+        vmov            d1,  d2
+        vmov            d2,  d3
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        add             r8,  r8,  #8
+        cmp             r8,  r6
+        blt             4b
+        pop             {r4-r11, pc}
+endfunc
+.endm
+
+@ vertical, int16 source (the second pass of hv): (sum >> 6) first
+.macro  epel_v16 kind, elsize
+function ff_hevc_epel_v16_\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_s16
+        mov             r8,  #0
+4:
+        epel_strip      0, \elsize
+        add             r11, r2,  r8,  lsl #1
+        sub             r11, r11, r3
+        vld1.8          {d20-d21}, [r11], r3
+        vld1.8          {d22-d23}, [r11], r3
+        vld1.8          {d24-d25}, [r11], r3
+5:
+        vld1.8          {d26-d27}, [r11], r3
+        vmull.s16       q8,  d20, d7[0]
+        vmlal.s16       q8,  d22, d7[1]
+        vmlal.s16       q8,  d24, d7[2]
+        vmlal.s16       q8,  d26, d7[3]
+        vmull.s16       q9,  d21, d7[0]
+        vmlal.s16       q9,  d23, d7[1]
+        vmlal.s16       q9,  d25, d7[2]
+        vmlal.s16       q9,  d27, d7[3]
+        vshrn.i32       d16, q8,  #6
+        vshrn.i32       d17, q9,  #6
+        vmov            q10, q11
+        vmov            q11, q12
+        vmov            q12, q13
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        add             r8,  r8,  #8
+        cmp             r8,  r6
+        blt             4b
+        pop             {r4-r11, pc}
+endfunc
+.endm
+
+epel_h   0, 2
+epel_h   1, 1
+epel_h   2, 1
+epel_v   0, 2
+epel_v   1, 1
+epel_v   2, 1
+epel_v16 0, 2
+epel_v16 1, 1
+epel_v16 2, 1
diff --git a/libavcodec/arm/hevcdsp_init_neon.c b/libavcodec/arm/hevcdsp_init_neon.c
index 112edb5..6769428 100644
--- a/libavcodec/arm/hevcdsp_init_neon.c
+++ b/libavcodec/arm/hevcdsp_init_neon.c
@@ -19,6 +19,7 @@
  */
 
 #include "libavutil/attributes.h"
+#include "libavutil/mem_internal.h"
 #include "libavutil/arm/cpu.h"
 #include "libavcodec/hevcdsp.h"
 #include "libavcodec/avcodec.h"
@@ -209,6 +210,88 @@ void ff_hevc_put_qpel_bi_neon_wrapper(uint8_t *dst, ptrdiff_t dststride, uint8_t
     put_hevc_qpel_uw_neon[my][mx](dst, dststride, src, srcstride, width, height, src2, MAX_PB_SIZE);
 }
 
+/* chroma (epel): hevcdsp_epel_neon.S; kind 0 int16_t out, 1 uni, 2 bi */
+#define EPEL_EXTRA 3                    /* as hevcdec.h: a row above, two below */
+#define EPEL_PROTO(name) \
+void name(void *dst, ptrdiff_t dststride, const void *src, ptrdiff_t srcstride, \
+          int height, const int8_t *filter, int width, const int16_t *src2)
+EPEL_PROTO(ff_hevc_epel_h0_neon_8);
+EPEL_PROTO(ff_hevc_epel_h1_neon_8);
+EPEL_PROTO(ff_hevc_epel_h2_neon_8);
+EPEL_PROTO(ff_hevc_epel_v0_neon_8);
+EPEL_PROTO(ff_hevc_epel_v1_neon_8);
+EPEL_PROTO(ff_hevc_epel_v2_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_0_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_1_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_2_neon_8);
+
+static void epel_h_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                        int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_h0_neon_8(dst, 2 * MAX_PB_SIZE, src, srcstride, height, ff_hevc_epel_filters[mx - 1], width, NULL);
+}
+
+static void epel_v_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                        int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_v0_neon_8(dst, 2 * MAX_PB_SIZE, src, srcstride, height, ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+/* hv: the horizontal pass into tmp (a row above and two below), then the
+   vertical pass over it, as hevcdsp_template.c does */
+#define EPEL_HV_TMP \
+    LOCAL_ALIGNED_16(int16_t, tmp, [(MAX_PB_SIZE + EPEL_EXTRA) * MAX_PB_SIZE]); \
+    ff_hevc_epel_h0_neon_8(tmp, 2 * MAX_PB_SIZE, src - srcstride, srcstride, height + EPEL_EXTRA, \
+                           ff_hevc_epel_filters[mx - 1], width, NULL)
+
+static void epel_hv_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                         int height, intptr_t mx, intptr_t my, int width)
+{
+    EPEL_HV_TMP;
+    ff_hevc_epel_v16_0_neon_8(dst, 2 * MAX_PB_SIZE, tmp + MAX_PB_SIZE, 2 * MAX_PB_SIZE, height,
+                              ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+static void epel_uni_h_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                            int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_h1_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[mx - 1], width, NULL);
+}
+
+static void epel_uni_v_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                            int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_v1_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+static void epel_uni_hv_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                             int height, intptr_t mx, intptr_t my, int width)
+{
+    EPEL_HV_TMP;
+    ff_hevc_epel_v16_1_neon_8(dst, dststride, tmp + MAX_PB_SIZE, 2 * MAX_PB_SIZE, height,
+                              ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+static void epel_bi_h_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                           int16_t *src2, int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_h2_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[mx - 1], width, src2);
+}
+
+static void epel_bi_v_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                           int16_t *src2, int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_v2_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[my - 1], width, src2);
+}
+
+static void epel_bi_hv_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                            int16_t *src2, int height, intptr_t mx, intptr_t my, int width)
+{
+    EPEL_HV_TMP;
+    ff_hevc_epel_v16_2_neon_8(dst, dststride, tmp + MAX_PB_SIZE, 2 * MAX_PB_SIZE, height,
+                              ff_hevc_epel_filters[my - 1], width, src2);
+}
+
 av_cold void ff_hevc_dsp_init_neon(HEVCDSPContext *c, const int bit_depth)
 {
     if (bit_depth == 8) {
@@ -300,6 +383,24 @@ av_cold void ff_hevc_dsp_init_neon(HEVCDSPContext *c, const int bit_depth)
         c->put_hevc_qpel_uni[7][0][0]  = ff_hevc_put_qpel_uw_pixels_w32_neon_8;
         c->put_hevc_qpel_uni[8][0][0]  = ff_hevc_put_qpel_uw_pixels_w48_neon_8;
         c->put_hevc_qpel_uni[9][0][0]  = ff_hevc_put_qpel_uw_pixels_w64_neon_8;
+
+        for (x = 0; x < 10; x++) {
+            /* chroma: the filters, every width (2 to 64) */
+            c->put_hevc_epel[x][0][1]     = epel_h_neon;
+            c->put_hevc_epel[x][1][0]     = epel_v_neon;
+            c->put_hevc_epel[x][1][1]     = epel_hv_neon;
+            c->put_hevc_epel_uni[x][0][1] = epel_uni_h_neon;
+            c->put_hevc_epel_uni[x][1][0] = epel_uni_v_neon;
+            c->put_hevc_epel_uni[x][1][1] = epel_uni_hv_neon;
+            c->put_hevc_epel_bi[x][0][1]  = epel_bi_h_neon;
+            c->put_hevc_epel_bi[x][1][0]  = epel_bi_v_neon;
+            c->put_hevc_epel_bi[x][1][1]  = epel_bi_hv_neon;
+            /* and whole-sample copies: the same functions as luma's (the C
+               uses one put_hevc_pel_pixels for both) */
+            c->put_hevc_epel[x][0][0]     = c->put_hevc_qpel[x][0][0];
+            c->put_hevc_epel_uni[x][0][0] = c->put_hevc_qpel_uni[x][0][0];
+            c->put_hevc_epel_bi[x][0][0]  = c->put_hevc_qpel_bi[x][0][0];
+        }
     }
 
     if (bit_depth == 10) {
