+#include "libavutil/arm/asm.S"
+
+@ Every function here:
+@ void f(void *dst, ptrdiff_t dststride, const void *src, ptrdiff_t srcstride,
+@        int height, const int8_t *filter, int width, const int16_t *src2)
+@   dst, dststride  the output (kind 0: int16_t rows, dststride in bytes)
+@   src, srcstride  the input at the block's top left (v16: int16_t rows)
+@   filter          4 taps, from ff_hevc_epel_filters
+@   width           2 .. 64, even;  height  1 .. 64 (+3 for hv's first pass)
+@   src2            kind 2 only: int16_t rows 128 bytes (MAX_PB_SIZE) apart
+@
+@ Core registers
+@   r0  dst          r1  dststride    r2  src          r3  srcstride
+@   r4  height       r5  filter, then a scratch pointer for tail stores
+@   r6  width        r7  src2         r8  x (the strip's first column)
+@   r9  rows left    r10 dst row      r11 src row      ip  src2 row
+@   lr  columns in this strip: 8, or 2 / 4 / 6 in the last one
+@
+@ NEON registers
+@   u8 taps:  d28 |f0|  d29 f1  d30 f2  d31 |f3|
+@   s16 taps: d7[0..3] = f0 .. f3 (by-scalar operands must be in d0-d7)
+@   q8  the 8 results of a row (int16);  d16 the 8 pixels once rounded
+@   q9  src2's 8 values (kind 2), or the high half's sums (v16)
+@   h:   d0-d1 the 16 source bytes from x-1, d2-d4 the views at x, x+1, x+2
+@   v:   d0-d3 rows y-1 .. y+2 (d3 the new one each step)
+@   v16: q10-q13 rows y-1 .. y+2 (q13 the new one each step)
+
+.macro  epel_start
+        push            {r4-r11, lr}
+        @ 9 registers pushed = 36 bytes: the stack arguments follow them
+        ldr             r4,  [sp, #36]          @ height
+        ldr             r5,  [sp, #40]          @ filter
+        ldr             r6,  [sp, #44]          @ width
+        ldr             r7,  [sp, #48]          @ src2
+.endm
+
+@ The taps for 8-bit sources: |f0| and |f3| (subtracted), f1 and f2 (added)
+.macro  epel_coeffs_u8
+        ldrsb           r8,  [r5]
+        ldrsb           r9,  [r5, #1]
+        ldrsb           r10, [r5, #2]
+        ldrsb           r11, [r5, #3]
+        rsb             r8,  r8,  #0            @ f0 and f3 are <= 0
+        rsb             r11, r11, #0
+        vdup.8          d28, r8
+        vdup.8          d29, r9
+        vdup.8          d30, r10
+        vdup.8          d31, r11
+.endm
+
+@ The taps as signed 16-bit scalars, for int16 sources
+.macro  epel_coeffs_s16
+        ldrsb           r8,  [r5]
+        ldrsb           r9,  [r5, #1]
+        ldrsb           r10, [r5, #2]
+        ldrsb           r11, [r5, #3]
+        vmov.16         d7[0], r8
+        vmov.16         d7[1], r9
+        vmov.16         d7[2], r10
+        vmov.16         d7[3], r11
+.endm
+
+@ The strip starting at column r8: its width (lr), dst and src2 pointers,
+@ and the row count. elsize: bytes a dst element (2 for kind 0, else 1).
+.macro  epel_strip elsize
+        sub             lr,  r6,  r8
+        cmp             lr,  #8
+        movgt           lr,  #8
+.if \elsize == 2
+        add             r10, r0,  r8,  lsl #1
+.else
+        add             r10, r0,  r8
+.endif
+        add             ip,  r7,  r8,  lsl #1
+        mov             r9,  r4
+.endm
+
+@ Stores bytes \first .. \last of d\reg at r5, advancing it
+.macro  store_lanes reg, first, last
+        .irp i, \first, \first+1
+        vst1.8          {d\reg[\i]}, [r5]!
+        .endr
+.if \last > \first + 1
+        store_lanes     \reg, \first+2, \last
+.endif
+.endm
+
+@ The row's results (q8) out, then r10 to the next row. A full strip is
+@ one store; a last strip of 2, 4 or 6 columns stores only those, a lane
+@ at a time (d16 holds columns 0-3 / 0-7 of int16 / uint8 output, d17 the rest).
+.macro  epel_out kind
+.if \kind == 0                                  @ int16_t: 2 bytes a column
+        cmp             lr,  #8
+        bne             1f
+        vst1.8          {d16-d17}, [r10], r1
+        b               2f
+        @ int16_t is always 2-byte aligned: 16-bit lane stores, with the
+        @ qualifier saying so (":16"; tools/neon-align.py leaves those alone)
+1:      mov             r5,  r10
+        vst1.16         {d16[0]}, [r5, :16]!    @ columns 0, 1
+        vst1.16         {d16[1]}, [r5, :16]!
+        cmp             lr,  #4
+        blt             3f
+        vst1.16         {d16[2]}, [r5, :16]!    @ columns 2, 3
+        vst1.16         {d16[3]}, [r5, :16]!
+        cmp             lr,  #6
+        blt             3f
+        vst1.16         {d17[0]}, [r5, :16]!    @ columns 4, 5
+        vst1.16         {d17[1]}, [r5, :16]!
+3:      add             r10, r10, r1
+2:
+.else                                           @ uint8_t pixels
+.if \kind == 2
+        vld1.8          {d18-d19}, [ip]         @ src2's row (int16, any alignment)
+        add             ip,  ip,  #128
+        vqadd.s16       q8,  q8,  q9            @ + src2 (saturating: exact after the clip)
+        vqrshrun.s16    d16, q8,  #7            @ clip_u8((. + 64) >> 7)
+.else
+        vqrshrun.s16    d16, q8,  #6            @ clip_u8((. + 32) >> 6)
+.endif
+        cmp             lr,  #8
+        bne             1f
+        vst1.8          {d16}, [r10], r1
+        b               2f
+1:      mov             r5,  r10
+        store_lanes     16, 0, 1
+        cmp             lr,  #4
+        blt             3f
+        store_lanes     16, 2, 3
+        cmp             lr,  #6
+        blt             3f
+        store_lanes     16, 4, 5
+3:      add             r10, r10, r1
+2:
+.endif
+.endm
+
+@ The outer loop: the strips, 8 columns apart
+.macro  epel_next_strip
+        add             r8,  r8,  #8
+        cmp             r8,  r6
+        blt             4b
+        pop             {r4-r11, pc}
+.endm
+
+@ Horizontal: 8-bit source; taps at x-1 .. x+2
+.macro  epel_h kind, elsize
+function ff_hevc_epel_h\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_u8
+        mov             r8,  #0
+4:
+        epel_strip      \elsize
+        add             r11, r2,  r8
+        sub             r11, r11, #1
+5:
+        vld1.8          {d0-d1}, [r11], r3      @ 16 bytes from x-1 (11 are used)
+        vext.8          d2,  d0,  d1,  #1       @ x
+        vext.8          d3,  d0,  d1,  #2       @ x+1
+        vext.8          d4,  d0,  d1,  #3       @ x+2
+        vmull.u8        q8,  d2,  d29           @ F = f1*s[x] + f2*s[x+1]
+        vmlal.u8        q8,  d3,  d30
+        vmlsl.u8        q8,  d0,  d28           @   - |f0|*s[x-1] - |f3|*s[x+2]
+        vmlsl.u8        q8,  d4,  d31
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        epel_next_strip
+endfunc
+.endm
+
+@ Vertical: 8-bit source; rows y-1 .. y+2, three loaded before the loop
+.macro  epel_v kind, elsize
+function ff_hevc_epel_v\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_u8
+        mov             r8,  #0
+4:
+        epel_strip      \elsize
+        add             r11, r2,  r8
+        sub             r11, r11, r3            @ from the row above
+        vld1.8          {d0}, [r11], r3         @ y-1
+        vld1.8          {d1}, [r11], r3         @ y
+        vld1.8          {d2}, [r11], r3         @ y+1
+5:
+        vld1.8          {d3}, [r11], r3         @ y+2
+        vmull.u8        q8,  d1,  d29
+        vmlal.u8        q8,  d2,  d30
+        vmlsl.u8        q8,  d0,  d28
+        vmlsl.u8        q8,  d3,  d31
+        vmov            d0,  d1                 @ the window moves down a row
+        vmov            d1,  d2
+        vmov            d2,  d3
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        epel_next_strip
+endfunc
+.endm
+
+@ Vertical on int16 rows (hv's second pass, over the first's output):
+@ 32-bit sums, then >> 6 into q8
+.macro  epel_v16 kind, elsize
+function ff_hevc_epel_v16_\kind\()_neon_8, export=1
+        epel_start
+        epel_coeffs_s16
+        mov             r8,  #0
+4:
+        epel_strip      \elsize
+        add             r11, r2,  r8,  lsl #1
+        sub             r11, r11, r3
+        vld1.8          {d20-d21}, [r11], r3    @ y-1 (8 int16, any alignment)
+        vld1.8          {d22-d23}, [r11], r3    @ y
+        vld1.8          {d24-d25}, [r11], r3    @ y+1
+5:
+        vld1.8          {d26-d27}, [r11], r3    @ y+2
+        vmull.s16       q8,  d20, d7[0]         @ columns 0-3
+        vmlal.s16       q8,  d22, d7[1]
+        vmlal.s16       q8,  d24, d7[2]
+        vmlal.s16       q8,  d26, d7[3]
+        vmull.s16       q9,  d21, d7[0]         @ columns 4-7
+        vmlal.s16       q9,  d23, d7[1]
+        vmlal.s16       q9,  d25, d7[2]
+        vmlal.s16       q9,  d27, d7[3]
+        vshrn.i32       d16, q8,  #6            @ A = sum >> 6 (fits int16)
+        vshrn.i32       d17, q9,  #6
+        vmov            q10, q11                @ the window moves down a row
+        vmov            q11, q12
+        vmov            q12, q13
+        epel_out        \kind
+        subs            r9,  r9,  #1
+        bgt             5b
+        epel_next_strip
+endfunc
+.endm
+
+@ The nine functions: ff_hevc_epel_{h,v}{0,1,2}_neon_8 and
+@ ff_hevc_epel_v16_{0,1,2}_neon_8 (kind 0 writes int16, 2 bytes a column)
+epel_h   0, 2
+epel_h   1, 1
+epel_h   2, 1
+epel_v   0, 2
+epel_v   1, 1
+epel_v   2, 1
+epel_v16 0, 2
+epel_v16 1, 1
+epel_v16 2, 1
diff --git a/libavcodec/arm/hevcdsp_init_neon.c b/libavcodec/arm/hevcdsp_init_neon.c
index 112edb5..6769428 100644
--- a/libavcodec/arm/hevcdsp_init_neon.c
+++ b/libavcodec/arm/hevcdsp_init_neon.c
@@ -19,6 +19,7 @@
  */
 
 #include "libavutil/attributes.h"
+#include "libavutil/mem_internal.h"
 #include "libavutil/arm/cpu.h"
 #include "libavcodec/hevcdsp.h"
 #include "libavcodec/avcodec.h"
@@ -209,6 +210,88 @@ void ff_hevc_put_qpel_bi_neon_wrapper(uint8_t *dst, ptrdiff_t dststride, uint8_t
     put_hevc_qpel_uw_neon[my][mx](dst, dststride, src, srcstride, width, height, src2, MAX_PB_SIZE);
 }
 
+/* chroma (epel): hevcdsp_epel_neon.S; kind 0 int16_t out, 1 uni, 2 bi */
+#define EPEL_EXTRA 3                    /* as hevcdec.h: a row above, two below */
+#define EPEL_PROTO(name) \
+void name(void *dst, ptrdiff_t dststride, const void *src, ptrdiff_t srcstride, \
+          int height, const int8_t *filter, int width, const int16_t *src2)
+EPEL_PROTO(ff_hevc_epel_h0_neon_8);
+EPEL_PROTO(ff_hevc_epel_h1_neon_8);
+EPEL_PROTO(ff_hevc_epel_h2_neon_8);
+EPEL_PROTO(ff_hevc_epel_v0_neon_8);
+EPEL_PROTO(ff_hevc_epel_v1_neon_8);
+EPEL_PROTO(ff_hevc_epel_v2_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_0_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_1_neon_8);
+EPEL_PROTO(ff_hevc_epel_v16_2_neon_8);
+
+static void epel_h_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                        int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_h0_neon_8(dst, 2 * MAX_PB_SIZE, src, srcstride, height, ff_hevc_epel_filters[mx - 1], width, NULL);
+}
+
+static void epel_v_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                        int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_v0_neon_8(dst, 2 * MAX_PB_SIZE, src, srcstride, height, ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+/* hv: the horizontal pass into tmp (a row above and two below), then the
+   vertical pass over it, as hevcdsp_template.c does */
+#define EPEL_HV_TMP \
+    LOCAL_ALIGNED_16(int16_t, tmp, [(MAX_PB_SIZE + EPEL_EXTRA) * MAX_PB_SIZE]); \
+    ff_hevc_epel_h0_neon_8(tmp, 2 * MAX_PB_SIZE, src - srcstride, srcstride, height + EPEL_EXTRA, \
+                           ff_hevc_epel_filters[mx - 1], width, NULL)
+
+static void epel_hv_neon(int16_t *dst, uint8_t *src, ptrdiff_t srcstride,
+                         int height, intptr_t mx, intptr_t my, int width)
+{
+    EPEL_HV_TMP;
+    ff_hevc_epel_v16_0_neon_8(dst, 2 * MAX_PB_SIZE, tmp + MAX_PB_SIZE, 2 * MAX_PB_SIZE, height,
+                              ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+static void epel_uni_h_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                            int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_h1_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[mx - 1], width, NULL);
+}
+
+static void epel_uni_v_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                            int height, intptr_t mx, intptr_t my, int width)
+{
+    ff_hevc_epel_v1_neon_8(dst, dststride, src, srcstride, height, ff_hevc_epel_filters[my - 1], width, NULL);
+}
+
+static void epel_uni_hv_neon(uint8_t *dst, ptrdiff_t dststride, uint8_t *src, ptrdiff_t srcstride,
+                             int height, intptr_t mx, intptr_t my, int width)
+{
+    EPEL_HV_TMP;
+    ff_hevc_epel_v16_1_neon_8(dst, dststride, tmp + MAX_PB_SIZE, 2 * MAX_PB_SIZE, height,
