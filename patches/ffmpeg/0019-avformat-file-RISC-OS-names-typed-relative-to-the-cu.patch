From e65d85c037e19a4008915aa831ccf6b0cfc10545 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Tue, 29 Sep 2026 09:23:31 +0100
Subject: [PATCH] avformat/file: RISC OS names typed relative to the current
 directory (holiday/mp4)

UnixLib reads a name with no prefix as a Unix one, so holiday/mp4 became
the file mp4 in the directory holiday. When a name has one '/', no '.'
after it, no filing system or directory prefix, and what follows the '/'
is an extension of a format FFmpeg knows, it is a RISC OS name: open
@.holiday/mp4, which UnixLib leaves alone. Unix names (clip.mp4,
dir/clip.mp4, videos/clip) are unchanged.
---
 libavformat/file.c            | 43 +++++++++++++++++++++++
 libavformat/riscos_filename.h | 66 +++++++++++++++++++++++++++++++++++
 2 files changed, 109 insertions(+)
 create mode 100644 libavformat/riscos_filename.h

diff --git a/libavformat/file.c b/libavformat/file.c
index 98c9e81..0afcf3c 100644
--- a/libavformat/file.c
+++ b/libavformat/file.c
@@ -39,6 +39,39 @@
 #include <stdlib.h>
 #include "os_support.h"
 #include "url.h"
+#ifdef __riscos__
+#include <ctype.h>
+#include "riscos_filename.h"
+
+/* Is ext the file extension of a format FFmpeg knows (either way)? */
+static int riscos_known_ext(const char *ext)
+{
+    const AVOutputFormat *o;
+    const AVInputFormat *i;
+    void *it = NULL;
+    char low[9];
+    size_t n;
+    for (n = 0; ext[n] && n < sizeof(low) - 1; n++)
+        low[n] = tolower((unsigned char)ext[n]);
+    low[n] = 0;
+    while ((o = av_muxer_iterate(&it)))
+        if (o->extensions && av_match_name(low, o->extensions))
+            return 1;
+    it = NULL;
+    while ((i = av_demuxer_iterate(&it)))
+        if (i->extensions && av_match_name(low, i->extensions))
+            return 1;
+    return 0;
+}
+
+/* "holiday/mp4" typed in the current directory: see riscos_filename.h */
+#define RISCOS_NAME_BUF(buf) char buf[1024]
+#define RISCOS_NAME(name, buf) \
+    (name = ff_riscos_relative_name(name, buf, sizeof(buf), riscos_known_ext))
+#else
+#define RISCOS_NAME_BUF(buf) int buf av_unused
+#define RISCOS_NAME(name, buf) ((void)0)
+#endif
 
 /* Some systems may not have S_ISFIFO */
 #ifndef S_ISFIFO
@@ -140,7 +173,9 @@ static int file_check(URLContext *h, int mask)
 {
     int ret = 0;
     const char *filename = h->filename;
+    RISCOS_NAME_BUF(rbuf);
     av_strstart(filename, "file:", &filename);
+    RISCOS_NAME(filename, rbuf);
 
     {
 #if HAVE_ACCESS && defined(R_OK)
@@ -172,7 +207,9 @@ static int file_delete(URLContext *h)
 #if HAVE_UNISTD_H
     int ret;
     const char *filename = h->filename;
+    RISCOS_NAME_BUF(rbuf);
     av_strstart(filename, "file:", &filename);
+    RISCOS_NAME(filename, rbuf);
 
     ret = rmdir(filename);
     if (ret < 0 && (errno == ENOTDIR
@@ -194,8 +231,12 @@ static int file_move(URLContext *h_src, URLContext *h_dst)
 {
     const char *filename_src = h_src->filename;
     const char *filename_dst = h_dst->filename;
+    RISCOS_NAME_BUF(rbuf_src);
+    RISCOS_NAME_BUF(rbuf_dst);
     av_strstart(filename_src, "file:", &filename_src);
     av_strstart(filename_dst, "file:", &filename_dst);
+    RISCOS_NAME(filename_src, rbuf_src);
+    RISCOS_NAME(filename_dst, rbuf_dst);
 
     if (rename(filename_src, filename_dst) < 0)
         return AVERROR(errno);
@@ -209,8 +250,10 @@ static int file_open(URLContext *h, const char *filename, int flags)
     int access;
     int fd;
     struct stat st;
+    RISCOS_NAME_BUF(rbuf);
 
     av_strstart(filename, "file:", &filename);
+    RISCOS_NAME(filename, rbuf);
 
     if (flags & AVIO_FLAG_WRITE && flags & AVIO_FLAG_READ) {
         access = O_CREAT | O_RDWR;
diff --git a/libavformat/riscos_filename.h b/libavformat/riscos_filename.h
new file mode 100644
index 0000000..a3b80fe
--- /dev/null
+++ b/libavformat/riscos_filename.h
@@ -0,0 +1,66 @@
+/*
+ * RISC OS file names typed without a filing system or directory prefix
+ *
