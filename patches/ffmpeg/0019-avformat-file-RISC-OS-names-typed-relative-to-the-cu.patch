+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVFORMAT_RISCOS_FILENAME_H
+#define AVFORMAT_RISCOS_FILENAME_H
+
+#include <stddef.h>
+#include <string.h>
+
+/*
+ * UnixLib (the C library) turns Unix style names into RISC OS ones:
+ * "clip.mp4" becomes clip/mp4, "dir/clip.mp4" dir.clip/mp4. Names it sees
+ * as RISC OS ones (a filing system, disc or path variable prefix, or one
+ * starting with $ @ ^ % & < \) are left alone. So a RISC OS name typed
+ * relative to the current directory, "holiday/mp4", is read as the Unix
+ * name "holiday/mp4": the file "mp4" in the directory "holiday". People
+ * on RISC OS mean the file holiday/mp4, as everywhere else in RISC OS.
+ *
+ * ff_riscos_relative_name() spots such names and puts "@." in front
+ * ("@.holiday/mp4": the current directory), which UnixLib leaves alone:
+ * the name has one '/', no '.' after it, no prefix, and what follows the
+ * '/' is a file extension FFmpeg knows (known_ext). A '.' before the '/'
+ * is a RISC OS directory ("Films.holiday/mp4"). Unix names still work:
+ * "clip.mp4", "dir/clip.mp4", "a/b/c" and "videos/clip" (not an
+ * extension) are unchanged. Returns buf holding the new name, or name.
+ */
+static inline const char *ff_riscos_relative_name(const char *name, char *buf, size_t size,
+                                                  int (*known_ext)(const char *ext))
+{
+    const char *slash = strrchr(name, '/'), *ext;
+    size_t n = strlen(name);
+
+    if (!name[0] || strchr("/$@^%&<\\.:", name[0]) || strchr(name, ':') || !slash ||
+        strchr(name, '/') != slash || strchr(slash, '.') || n + 3 > size)
+        return name;
+    ext = slash + 1;
+    if (!ext[0] || strlen(ext) > 8 || slash == name)
+        return name;
+    for (const char *p = ext; *p; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9')))
+            return name;
+    if (!known_ext(ext))
+        return name;
+    memcpy(buf, "@.", 2);
+    memcpy(buf + 2, name, n + 1);
+    return buf;
+}
+
+#endif /* AVFORMAT_RISCOS_FILENAME_H */
-- 
2.43.0

