 libswscale/arm/swscale.c         | 135 ++++++++++++
 libswscale/swscale_internal.h    |   9 +
 libswscale/yuv2rgb.c             |  21 ++
 5 files changed, 511 insertions(+)
 create mode 100644 libswscale/arm/scaled_rgb_neon.S

