From 093119d4e0aed377080b96aa6054fe13a717016b Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Fri, 2 Oct 2026 17:43:50 +0100
Subject: [PATCH] avcodec/h264_vchiq: drop_before, late pictures released
 unseen

A player that has fallen behind sets drop_before (a pts in pkt_timebase):
pictures with an earlier pts go straight back to the VideoCore, neither
copied nor held by a frame nobody will see. Off (INT64_MIN) by default.
---
 libavcodec/vchiqdec.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/libavcodec/vchiqdec.c b/libavcodec/vchiqdec.c
index 43820bd..a0059c1 100644
--- a/libavcodec/vchiqdec.c
+++ b/libavcodec/vchiqdec.c
@@ -74,6 +74,8 @@ typedef struct VCHIQContext {
     int pci_memory;                         /* option */
     int zero_copy;                          /* option */
     int out_buffers;                        /* option */
+    int64_t drop_before;                    /* option: pictures with an earlier pts are released unseen */
+    unsigned dropped;
 } VCHIQContext;
 
 static void vchiq_log(void *h, const char *text)
@@ -123,6 +125,8 @@ static int check_profile(AVCodecContext *avctx)
 static av_cold int vchiq_close(AVCodecContext *avctx)
 {
     VCHIQContext *s = avctx->priv_data;
+    if (s->dropped)
+        av_log(avctx, AV_LOG_VERBOSE, "%u late pictures released unseen\n", s->dropped);
     vcdec_close(s->d);
     s->d = NULL;
     av_packet_free(&s->pkt);
@@ -311,6 +315,14 @@ static int vchiq_receive_frame(AVCodecContext *avctx, AVFrame *frame)
         int progress = 0;
         /* a picture ready: out */
         r = vcdec_peek(s->d, &pic);
+        if (r == VCDEC_OK && s->drop_before != INT64_MIN && pic.pts != AV_NOPTS_VALUE && pic.pts < s->drop_before) {
+            /* too late to be shown: given straight back to the VideoCore
+               (no copy, and no buffer held by a frame nobody will see) */
+            if ((r = vcdec_receive(s->d, NULL, NULL, NULL)) != VCDEC_OK)
+                return r < 0 ? map_result(avctx, s, r, "Dropping") : AVERROR_BUG;
+            s->dropped++;
+            continue;
+        }
         if (r == VCDEC_OK)
             return output_frame(avctx, s, frame, &pic);
         if (r == VCDEC_EOF)
@@ -375,6 +387,8 @@ static const AVOption options[] = {
       AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, VD },
     { "out_buffers", "the decoder's picture buffers (0: 6 with zero_copy, else 3)", OFFSET(out_buffers),
       AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 16, VD },
+    { "drop_before", "release the pictures with an earlier pts (pkt_timebase) unseen; a player that is behind "
+      "sets it as it goes", OFFSET(drop_before), AV_OPT_TYPE_INT64, { .i64 = INT64_MIN }, INT64_MIN, INT64_MAX, VD },
     { NULL }
 };
 
