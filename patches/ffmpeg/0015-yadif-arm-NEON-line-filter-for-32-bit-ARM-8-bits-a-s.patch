+#include "libavutil/attributes.h"
+#include "libavutil/cpu.h"
+#include "libavutil/arm/cpu.h"
+#include "libavfilter/yadif.h"
+
+void ff_yadif_filter_line_neon(void *dst, void *prev, void *cur, void *next,
+                               int w, int prefs, int mrefs, int parity, int mode);
+
+av_cold void ff_yadif_init_arm(YADIFContext *yadif)
+{
+    int cpu_flags = av_get_cpu_flags();
+    int bit_depth = yadif->csp ? yadif->csp->comp[0].depth : 8;
+
+    if (have_neon(cpu_flags) && bit_depth <= 8)
+        yadif->filter_line = ff_yadif_filter_line_neon;
+}
diff --git a/libavfilter/arm/vf_yadif_neon.S b/libavfilter/arm/vf_yadif_neon.S
new file mode 100644
index 0000000..8f34e13
--- /dev/null
+++ b/libavfilter/arm/vf_yadif_neon.S
@@ -0,0 +1,198 @@
+/*
+ * yadif: the line filter in NEON for 32-bit ARM, 8 bits a sample
+ *
+ * Bit-exact with filter_line_c (vf_yadif.c): eight pixels an iteration,
+ * the sums and scores in 16 bits, the averages ((a + b) >> 1) with vhadd.
+ * Byte-element loads and stores only, so it needs no alignment (RISC OS
+ * traps unaligned wider-element accesses). Like the x86 versions it may
+ * read up to 2 bytes and write up to 7 pixels past w (vf_yadif.c leaves
+ * that room and filter_edges writes the right-hand pixels afterwards).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/arm/asm.S"
+
+@ void ff_yadif_filter_line_neon(uint8_t *dst, uint8_t *prev, uint8_t *cur,
+@                                uint8_t *next, int w, int prefs, int mrefs,
+@                                int parity, int mode)
+@
+@ r0 dst, r1 prev, r2 cur, r3 next, r4 pixels left, r5 prefs, r6 mrefs,
+@ r7 prev2 (parity ? prev : cur), r8 next2 (parity ? cur : next), r9 mode,
+@ ip, lr addresses.
+@
+@ d16 m-3 (cur[mrefs - 3]), d20 m-2, d21 m-1, d22 m0 (c), d23 m1, d24 m2, d25 m3
+@ d18 p-3 (cur[prefs - 3]), d26 p-2, d27 p-1, d28 p0 (e), d29 p1, d30 p2, d31 p3
+@ d17 spatial_pred, q0 spatial_score, q4 1s
+
+function ff_yadif_filter_line_neon, export=1
+        push            {r4-r9, lr}
+        vpush           {d8-d9}
+        ldr             r4,  [sp, #44]          @ w
+        ldr             r5,  [sp, #48]          @ prefs
+        ldr             r6,  [sp, #52]          @ mrefs
+        ldr             r7,  [sp, #56]          @ parity
+        ldr             r9,  [sp, #60]          @ mode
+        cmp             r7,  #0
+        movne           r7,  r1                 @ prev2
+        moveq           r7,  r2
+        movne           r8,  r2                 @ next2
+        moveq           r8,  r3
+        cmp             r4,  #0
+        ble             9f
+        vmov.i16        q4,  #1
+1:
+        @ the spatial prediction: cur's lines above (m) and below (p)
+        add             ip,  r2,  r6
+        sub             ip,  ip,  #3
+        vld1.8          {d16-d17}, [ip]
+        add             ip,  r2,  r5
+        sub             ip,  ip,  #3
+        vld1.8          {d18-d19}, [ip]
+        vext.8          d20, d16, d17, #1
+        vext.8          d21, d16, d17, #2
+        vext.8          d22, d16, d17, #3
+        vext.8          d23, d16, d17, #4
+        vext.8          d24, d16, d17, #5
+        vext.8          d25, d16, d17, #6
+        vext.8          d26, d18, d19, #1
+        vext.8          d27, d18, d19, #2
+        vext.8          d28, d18, d19, #3
+        vext.8          d29, d18, d19, #4
+        vext.8          d30, d18, d19, #5
+        vext.8          d31, d18, d19, #6
+
+        vhadd.u8        d17, d22, d28           @ spatial_pred = (c + e) >> 1
+        vabdl.u8        q0,  d21, d27           @ spatial_score
+        vabal.u8        q0,  d22, d28
+        vabal.u8        q0,  d23, d29
+        vsub.i16        q0,  q0,  q4            @ ... - 1
+
+        @ CHECK(-1)
+        vabdl.u8        q1,  d20, d28
+        vabal.u8        q1,  d21, d29
+        vabal.u8        q1,  d22, d30
+        vcgt.s16        q2,  q0,  q1            @ score < spatial_score
+        vmin.s16        q0,  q0,  q1
+        vhadd.u8        d19, d21, d29
+        vmovn.i16       d6,  q2
+        vbit            d17, d19, d6
+        @ CHECK(-2), only where CHECK(-1) chose
+        vabdl.u8        q1,  d16, d29
+        vabal.u8        q1,  d20, d30
+        vabal.u8        q1,  d21, d31
+        vcgt.s16        q3,  q0,  q1
+        vand            q3,  q3,  q2
+        vbit            q0,  q1,  q3
+        vhadd.u8        d19, d20, d30
+        vmovn.i16       d6,  q3
+        vbit            d17, d19, d6
+        @ CHECK(1)
+        vabdl.u8        q1,  d22, d26
+        vabal.u8        q1,  d23, d27
+        vabal.u8        q1,  d24, d28
+        vcgt.s16        q2,  q0,  q1
+        vmin.s16        q0,  q0,  q1
+        vhadd.u8        d19, d23, d27
+        vmovn.i16       d6,  q2
+        vbit            d17, d19, d6
+        @ CHECK(2), only where CHECK(1) chose
+        vabdl.u8        q1,  d23, d18
+        vabal.u8        q1,  d24, d26
+        vabal.u8        q1,  d25, d27
+        vcgt.s16        q3,  q0,  q1
+        vand            q3,  q3,  q2
+        vhadd.u8        d19, d24, d26
+        vmovn.i16       d6,  q3
+        vbit            d17, d19, d6
+
+        @ the temporal prediction
+        vld1.8          {d0}, [r7]              @ prev2[0]
+        vld1.8          {d1}, [r8]              @ next2[0]
+        add             ip,  r1,  r6
+        vld1.8          {d2}, [ip]              @ prev[mrefs]
+        add             ip,  r1,  r5
+        vld1.8          {d3}, [ip]              @ prev[prefs]
+        add             ip,  r3,  r6
+        vld1.8          {d4}, [ip]              @ next[mrefs]
+        add             ip,  r3,  r5
+        vld1.8          {d5}, [ip]              @ next[prefs]
+        vhadd.u8        d19, d0,  d1            @ d
+        vabd.u8         d6,  d0,  d1            @ temporal_diff0
+        vshr.u8         d6,  d6,  #1
+        vabdl.u8        q10, d2,  d22           @ temporal_diff1
+        vabal.u8        q10, d3,  d28
+        vshr.u16        q10, q10, #1
+        vabdl.u8        q12, d4,  d22           @ temporal_diff2
+        vabal.u8        q12, d5,  d28
+        vshr.u16        q12, q12, #1
+        vmovl.u8        q13, d6                 @ diff
+        vmax.u16        q13, q13, q10
+        vmax.u16        q13, q13, q12
+        vmovl.u8        q15, d19                @ d, 16 bits
+
+        tst             r9,  #2
+        bne             2f
+        lsl             lr,  r6,  #1
+        add             ip,  r7,  lr
+        vld1.8          {d0}, [ip]              @ prev2[2 * mrefs]
+        add             ip,  r8,  lr
+        vld1.8          {d1}, [ip]              @ next2[2 * mrefs]
+        lsl             lr,  r5,  #1
+        add             ip,  r7,  lr
+        vld1.8          {d2}, [ip]              @ prev2[2 * prefs]
+        add             ip,  r8,  lr
+        vld1.8          {d3}, [ip]              @ next2[2 * prefs]
+        vhadd.u8        d0,  d0,  d1            @ b
+        vhadd.u8        d2,  d2,  d3            @ f
+        vmovl.u8        q10, d28                @ e
+        vmovl.u8        q12, d22                @ c
+        vmovl.u8        q2,  d0
+        vmovl.u8        q3,  d2
+        vsub.i16        q0,  q15, q10           @ d - e
+        vsub.i16        q1,  q15, q12           @ d - c
+        vsub.i16        q2,  q2,  q12           @ b - c
+        vsub.i16        q3,  q3,  q10           @ f - e
+        vmin.s16        q14, q2,  q3            @ max
+        vmax.s16        q14, q14, q0
+        vmax.s16        q14, q14, q1
+        vmax.s16        q2,  q2,  q3            @ min
+        vmin.s16        q2,  q2,  q0
+        vmin.s16        q2,  q2,  q1
+        vneg.s16        q14, q14
+        vmax.s16        q13, q13, q2            @ diff = FFMAX3(diff, min, -max)
+        vmax.s16        q13, q13, q14
+2:
+        vmovl.u8        q0,  d17                @ spatial_pred into [d - diff, d + diff]
+        vsub.i16        q1,  q15, q13
+        vadd.i16        q2,  q15, q13
+        vmax.s16        q0,  q0,  q1
+        vmin.s16        q0,  q0,  q2
+        vmovn.i16       d0,  q0
+        vst1.8          {d0}, [r0]!
+
+        add             r1,  r1,  #8
+        add             r2,  r2,  #8
+        add             r3,  r3,  #8
+        add             r7,  r7,  #8
+        add             r8,  r8,  #8
+        subs            r4,  r4,  #8
+        bgt             1b
+9:
+        vpop            {d8-d9}
+        pop             {r4-r9, pc}
+endfunc
diff --git a/libavfilter/vf_yadif.c b/libavfilter/vf_yadif.c
index 094533f..a926e8c 100644
--- a/libavfilter/vf_yadif.c
+++ b/libavfilter/vf_yadif.c
@@ -315,6 +315,9 @@ static int config_output(AVFilterLink *outlink)
 #if ARCH_X86
     ff_yadif_init_x86(s);
 #endif
+#if ARCH_ARM
+    ff_yadif_init_arm(s);
+#endif
 
     return 0;
 }
diff --git a/libavfilter/yadif.h b/libavfilter/yadif.h
index c928911..a208ba5 100644
--- a/libavfilter/yadif.h
+++ b/libavfilter/yadif.h
@@ -87,6 +87,7 @@ typedef struct YADIFContext {
 } YADIFContext;
 
 void ff_yadif_init_x86(YADIFContext *yadif);
+void ff_yadif_init_arm(YADIFContext *yadif);
 
 int ff_yadif_filter_frame(AVFilterLink *link, AVFrame *frame);
 
