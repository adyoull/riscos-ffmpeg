From d54f171316b19c5ef65821ba486e2a33ded4f564 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Sun, 27 Sep 2026 09:47:25 +0100
Subject: [PATCH] hevc arm: write out the w4/w12 pixel copies (single lanes)
 for neon-align

---
 libavcodec/arm/hevcdsp_qpel_neon.S | 43 ++++++++++++++++++++++++++++--
 1 file changed, 41 insertions(+), 2 deletions(-)

diff --git a/libavcodec/arm/hevcdsp_qpel_neon.S b/libavcodec/arm/hevcdsp_qpel_neon.S
index caa6efa..75025d7 100644
--- a/libavcodec/arm/hevcdsp_qpel_neon.S
+++ b/libavcodec/arm/hevcdsp_qpel_neon.S
@@ -989,9 +989,48 @@ function ff_hevc_put_qpel_uw_pixels_w\width\()_neon_8, export=1
 endfunc
 .endm
 
-put_qpel_uw_pixels    4, d0[0], d0[1], d1[0], d1[1]
+@ RISC OS: w4 and w12 are written out rather than made from the macros,
+@ because they move single lanes (d0[0]) that tools/neon-align.py has to
+@ see to make them alignment-safe; the macros are left for whole registers.
+function ff_hevc_put_qpel_uw_pixels_w4_neon_8, export=1
+        ldr    r12, [sp] // height
+1:      subs   r12, #4
+        vld1.32     {d0[0]}, [r2], r3
+        vld1.32     {d0[1]}, [r2], r3
+        vld1.32     {d1[0]}, [r2], r3
+        vld1.32     {d1[1]}, [r2], r3
+        vst1.32     {d0[0]}, [r0], r1
+        vst1.32     {d0[1]}, [r0], r1
+        vst1.32     {d1[0]}, [r0], r1
+        vst1.32     {d1[1]}, [r0], r1
+        bne 1b
+        bx lr
+endfunc
 put_qpel_uw_pixels    8, d0,    d1,    d2,    d3
-put_qpel_uw_pixels_m 12, d0,    d1[0], d2,    d3[0]
+function ff_hevc_put_qpel_uw_pixels_w12_neon_8, export=1
+        push   {r4-r5}
+        ldr    r12, [sp, #8] // height
+1:      subs r12, #2
+        mov      r4, r2
+        vld1.32   {d0} , [r2]!
+        vld1.32   {d1[0]} , [r2]
+        add      r2, r4, r3
+        mov      r4, r2
+        vld1.32   {d2} , [r2]!
+        vld1.32   {d3[0]} , [r2]
+        add      r2, r4, r3
+        mov      r5, r0
+        vst1.32   {d0} , [r0]!
+        vst1.32   {d1[0]} , [r0]
+        add      r0, r5, r1
+        mov      r5, r0
+        vst1.32   {d2} , [r0]!
+        vst1.32   {d3[0]} , [r0]
+        add      r0, r5, r1
+        bne 1b
+        pop   {r4-r5}
+        bx lr
+endfunc
 put_qpel_uw_pixels   16, q0,    q1,    q2,    q3
 put_qpel_uw_pixels   24, d0-d2, d3-d5, d16-d18, d19-d21
 put_qpel_uw_pixels   32, q0-q1, q2-q3, q8-q9, q10-q11
