| !Boot for !FFmpeg (FFmpeg 5.1.10 LTS for RISC OS)
| Seen by the Filer: sets up the commands so they work from any command
| line or TaskWindow.
If "<FFmpeg$Dir>"="" Then Set FFmpeg$Dir <Obey$Dir>
IconSprites <FFmpeg$Dir>.!Sprites
| Each program is about 23MB and needs about 32MB of application space
| (its heap is in a dynamic area, "FFmpeg Heap").
Set Alias$ffmpeg  WimpSlot -min 34816K|MRun <FFmpeg$Dir>.ffmpeg %%*0
Set Alias$ffprobe WimpSlot -min 34816K|MRun <FFmpeg$Dir>.ffprobe %%*0
Set Alias$ffplay  WimpSlot -min 34816K|MRun <FFmpeg$Dir>.ffplay %%*0
